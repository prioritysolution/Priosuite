  import type { LucideIcon } from "lucide-react";

export interface SummaryCardData {
  id: string;
  label: string;
  value: string;
  subtext: string;
  icon: LucideIcon;
  iconBg: string;
  iconColor: string;
  valueColor?: string;
  maskable?: boolean;
}

export type TransactionType = "credit" | "debit";

export interface Transaction {
  id: string;
  date: string;
  description: string;
  accountNo: string;
  type: TransactionType;
  amount: number;
  balance: number;
}

export interface AccountDetail {
  label: string;
  value: string;
  highlight?: boolean;
}

export interface QuickAction {
  id: string;
  label: string;
  icon: LucideIcon;
  iconBg: string;
  iconColor: string;
  href: string;
}