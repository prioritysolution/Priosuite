import { cn } from "@/lib/utils";
import type { StatCardData } from "@/lib/types";

const ACCENT_BORDER: Record<StatCardData["accentColor"], string> = {
  blue: "border-l-blue-500",
  green: "border-l-emerald-500",
  orange: "border-l-orange-500",
  purple: "border-l-violet-500",
};

const ICON_WRAPPER_BG: Record<StatCardData["accentColor"], string> = {
  blue: "bg-blue-50 text-blue-600",
  green: "bg-emerald-50 text-emerald-600",
  orange: "bg-orange-50 text-orange-600",
  purple: "bg-violet-50 text-violet-600",
};

const ICONS: Record<StatCardData["icon"], React.ElementType> = {
  wallet: Wallet,
  "trending-up": TrendingUp,
  "alert-triangle": AlertTriangle,
  users: Users,
};

const BADGE_TONE_CLASS: Record<NonNullable<StatCardData["badge"]>["tone"], string> = {
  success: "bg-emerald-50 text-emerald-700 hover:bg-emerald-50 border-emerald-200",
  warning: "bg-amber-50 text-amber-700 hover:bg-amber-50 border-amber-200",
  neutral: "bg-slate-100 text-slate-700 hover:bg-slate-100 border-slate-200",
};

export function StatCard({ data }: { data: StatCardData }) {
  const Icon = ICONS[data.icon];

  return (
    <Card
      className={cn(
        "border-l-4 shadow-sm transition-shadow hover:shadow-md",
        ACCENT_BORDER[data.accentColor],
      )}
    >
      <CardContent className="flex flex-col gap-3 p-4 sm:p-5">
        <div className="flex items-start justify-between gap-3">
          <span className="text-xs font-semibold uppercase tracking-wide text-muted-foreground">
            {data.label}
