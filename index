"use client";

import { useState } from "react";
import { Coins, Minus, Plus } from "lucide-react";
import { Badge } from "@/components/ui/badge";
import { Card, CardContent, CardHeader } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { formatINR } from "@/lib/format";
import { cn } from "@/lib/utils";
import type { CashTally, DenominationCount } from "@/lib/types";

// Parses "₹500 Notes" -> 500 so we can recompute each row's value live.
function denominationFace(label: string): number {
  const match = label.match(/(\d+)/);
  return match ? Number(match[1]) : 1;
}

function DenominationInput({
  denom,
  onChange,
}: {
  denom: DenominationCount;
  onChange: (id: string, count: number) => void;
}) {
  const face = denominationFace(denom.label);

  return (
    <div className="flex flex-col gap-2 rounded-lg border p-3">
      <span className="text-xs font-medium text-muted-foreground">
        {denom.label}
      </span>
      <div className="flex items-center gap-1">
        <Button
          type="button"
          variant="outline"
          size="icon"
          className="h-7 w-7 shrink-0"
          onClick={() => onChange(denom.id, Math.max(0, denom.count - 1))}
          aria-label={`Decrease ${denom.label}`}
        >
          <Minus className="h-3 w-3" />
        </Button>
        <Input
          type="number"
          inputMode="numeric"
          min={0}
          value={denom.count}
          onChange={(e) => onChange(denom.id, Math.max(0, Number(e.target.value) || 0))}
          className="h-8 text-center"
        />
        <Button
          type="button"
          variant="outline"
          size="icon"
          className="h-7 w-7 shrink-0"
          onClick={() => onChange(denom.id, denom.count + 1)}
          aria-label={`Increase ${denom.label}`}
        >
          <Plus className="h-3 w-3" />
        </Button>
      </div>
      <span className="text-sm font-semibold">
        {formatINR(denom.count * face, 0)}
      </span>
    </div>
  );
}

export function CashDenominationTally({ data }: { data: CashTally }) {
  const [denominations, setDenominations] = useState(data.denominations);

  const handleChange = (id: string, count: number) => {
    setDenominations((prev) =>
      prev.map((d) =>
        d.id === id ? { ...d, count, value: count * denominationFace(d.label) } : d,
      ),
    );
  };

  const totalCounted = denominations.reduce(
    (sum, d) => sum + d.count * denominationFace(d.label),
    0,
  );
  const isReconciled = data.isReconciled;

  return (
    <Card className="shadow-sm">
      <CardHeader className="flex flex-col gap-2 border-b sm:flex-row sm:items-start sm:justify-between">
        <div className="flex items-start gap-2">
          <Coins className="mt-0.5 h-4 w-4 text-amber-600" />
          <h3 className="text-sm font-semibold sm:text-base">
            Physical Cash Denomination Tally{" "}
            <span className="font-normal text-muted-foreground">
              (নোট ও কয়েন গণনা)
            </span>
          </h3>
        </div>
        <Badge
          variant="outline"
          className={cn(
            "w-fit shrink-0",
            isReconciled
              ? "border-emerald-200 bg-emerald-50 text-emerald-700"
              : "border-amber-200 bg-amber-50 text-amber-700",
          )}
        >
          {isReconciled ? "Reconciled Zero Variance" : "Variance Detected"}
        </Badge>
      </CardHeader>

      <CardContent className="flex flex-col gap-4 p-4 sm:p-5">
        <div className="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-6">
          {denominations.map((denom) => (
            <DenominationInput key={denom.id} denom={denom} onChange={handleChange} />
          ))}
        </div>

        <div className="flex flex-col gap-1 border-t pt-4 text-sm sm:flex-row sm:items-center sm:justify-between">
          <span className="font-medium">
            Total Physical Counted Cash: {formatINR(totalCounted, 2)}
          </span>
          <span
            className={cn(
              "font-medium",
              data.variance === 0 ? "text-emerald-600" : "text-emerald-600",
            )}
          >
            Variance: {formatINR(data.variance, 2)} (Balanced)
          </span>
        </div>
      </CardContent>
    </Card>
  );
}
